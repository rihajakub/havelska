# Lokální vývoj bez přihlášení. Na Vercelu tuto hodnotu nenastavovat.
LOCAL_DEV_BYPASS_AUTH=true

# Produkce na Vercelu: skutečné hodnoty nastavte jen v dashboardu, nikdy sem.
# APP_PASSWORD=...
# Google OAuth for the host dashboard. Register the exact callback URL in Google Cloud:
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REDIRECT_URI=https://www.havelska.cz/api/auth/google/callback
# AIRBNB_ICAL_URL=https://www.airbnb.com/calendar/ical/...
# ENABLE_PRODUCTION_APP=true
# DATABASE_URL=postgresql://...   # Neon pooled connection string

# Povinné před zapnutím veřejných check-in formulářů. Vygeneruj jednou pomocí:
# openssl rand -base64 32
# CHECKIN_DATA_ENCRYPTION_KEY=...
